APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# FRONTEND_URL is used by API redirect/callback configs and mailing links
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_QUEUE_RETRY_AFTER=90

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Exception/dev mail sink. Exception emails are only sent when MAIL_SEND_EXCEPTIONS=true.
MAIL_SEND_EXCEPTIONS=false
ADMIN_MAIL="hello@example.com"
DEV_MAIL="dev@example.com"
DEV_MAIL_MAILER=smtp
DEV_MAIL_SCHEME=null
DEV_MAIL_HOST=127.0.0.1
DEV_MAIL_PORT=2525
DEV_MAIL_USERNAME=null
DEV_MAIL_PASSWORD=null
DEV_MAIL_FROM_ADDRESS="dev@example.com"
DEV_MAIL_FROM_NAME="${APP_NAME}"
# MAIL_CC_ADDRESSES="hello@veriscore.app"
# DEV_MAIL_CC_ADDRESSES="dev@veriscore.app"

# Sanctum/SANCTUM_STATEFUL_DOMAINS - comma-separated SPA domains for stateful auth
SANCTUM_STATEFUL_DOMAINS="localhost,127.0.0.1"

# Media library disk
MEDIA_DISK=public

# WhatsApp chat link (used in chat message responses)
WHATAPP_CHAT_NUMBER="2348130000000"

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/api/paystack/callback

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_MAX_RETRIES=5
FLUTTERWAVE_CALLBACK_URL=http://localhost:3000/api/flutterwave/callback
FLUTTERWAVE_REDIRECT_SUCCESS=https://veriscore.app/payment/success
FLUTTERWAVE_REDIRECT_ERROR=https://veriscore.app/payment/error

# Mono (bank data) - leave empty unless the Mono module is enabled
MONO_SECRET_KEY=
MONO_FRONTEND_CALLBACK=http://localhost:3000/api/mono/callback
LOOKUP_MONO_SECRET_KEY=
LOOKUP_MONO_BASE_URL=https://api.withmono.com/v3

# Laravel Nightwatch (optional)
NIGHTWATCH_ENABLED=false
# NIGHTWATCH_TOKEN=

# Sentry (optional)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=

# Pulse
PULSE_ENABLED=true
PULSE_PATH=pulse

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Socialite - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${APP_URL}/auth/google/callback

# Socialite - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=${APP_URL}/auth/github/callback
